# Krea2 Trainer Runpod Environment File
# This file is parsed as KEY=VALUE pairs. Shell syntax is NOT supported.
# Existing process environment variables take precedence over these values.

TRAIN_MODE=standard
CACHE_MODE=all
CACHE_SKIP_EXISTING=1
FORCE_REBUILD_CACHE=0
OUTPUT_NAME=my_krea2_lora
MAX_TRAIN_EPOCHS=5
SAVE_EVERY_N_EPOCHS=1
MAX_DATA_LOADER_N_WORKERS=8
SEED=17415

# Do not commit secrets to this file. Pass them via Runpod Secrets instead.
# WANDB_API_KEY=
# HF_TOKEN=
